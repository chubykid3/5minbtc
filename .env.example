# .env.example — copy this to .env and fill in your real values.
# .env is in .gitignore and will never be committed to GitHub.
#
# How to use:
#   cp .env.example .env
#   nano .env        # fill in your values
#
# The bot loads this automatically at startup.

# ── Polymarket wallet credentials ──────────────────────────────────────────────
# Your Polygon wallet private key (the wallet your Polymarket account uses).
# MetaMask: Account Details → Export Private Key
# Email login: polymarket.com → Profile → Export Private Key
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Your wallet address (shown in Polymarket profile, starts with 0x)
POLYMARKET_PROXY_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# ── Trading switches ───────────────────────────────────────────────────────────
# Set to true only after verifying the bot works in dry-run mode.
ENABLE_LIVE_TRADING=false

# Bet sizing (in USDC)
BET_SIZE_USDC=5.0
MAX_DAILY_LOSS_USDC=50.0

# ── Optional: Ethereum RPC for Chainlink oracle ────────────────────────────────
# Leave blank to use the free public endpoints.
# ETH_RPC_URL=https://your-private-rpc-endpoint
